{
  "name": "eventmate-ai-backend",
  "version": "1.0.0",
  "description": "EventMate AI Backend powered by AWS Lambda, Amazon Bedrock, DynamoDB, and Cognito",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && esbuild src/handlers/lambda.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/handlers/lambda.js",
    "dev": "tsx watch src/local-server.ts",
    "start": "node dist/local-server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.750.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.750.0",
    "@aws-sdk/client-dynamodb": "^3.750.0",
    "@aws-sdk/lib-dynamodb": "^3.750.0",
    "@vendia/serverless-express": "^4.12.6",
    "aws-jwt-verify": "^4.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.8",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
