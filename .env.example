# AWS & Application Configuration for EventMate AI

# AWS Region & Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# DynamoDB Table Names (Provisioned by CDK or local)
DYNAMODB_TABLE_PREFIX=eventmate-ai
EVENTS_TABLE_NAME=eventmate-ai-events
TASKS_TABLE_NAME=eventmate-ai-tasks
CONVERSATIONS_TABLE_NAME=eventmate-ai-conversations
RESCUE_PROPOSALS_TABLE_NAME=eventmate-ai-rescue-proposals

# Amazon Cognito
COGNITO_USER_POOL_ID=us-east-1_example
COGNITO_CLIENT_ID=exampleclientid12345
COGNITO_REGION=us-east-1

# API Gateway & Backend
API_BASE_URL=http://localhost:3001
PORT=3001

# Frontend Vite Variables
VITE_API_BASE_URL=http://localhost:3001
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_example
VITE_COGNITO_CLIENT_ID=exampleclientid12345
VITE_ENABLE_DEMO_MODE=true
